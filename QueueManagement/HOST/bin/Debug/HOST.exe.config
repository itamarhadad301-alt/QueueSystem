<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<system.serviceModel>
		<services>
			<service name="WcfServiceLibrary.Service1">
				<endpoint address=""
                          binding="basicHttpBinding"
                          contract="WcfServiceLibrary.IService1"/>
				<host>
					<baseAddresses>
						<add baseAddress="http://localhost:8080/QueueService/"/>
					</baseAddresses>
				</host>
			</service>
		</services>
		<behaviors>
			<serviceBehaviors>
				<behavior>
					<serviceMetadata httpGetEnabled="true"/>
					<serviceDebug includeExceptionDetailInFaults="true"/>
				</behavior>
			</serviceBehaviors>
		</behaviors>
	</system.serviceModel>
</configuration>