<Window x:Class="AdminClient.ManageBranchesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Branches"
        Height="500" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F0F4F8" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input Fields -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Manage Branches" FontSize="20" FontWeight="Bold"
                       Foreground="#2C3E50" Margin="0,0,0,12"/>

            <TextBlock Text="Branch Name" Foreground="#555" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtBranchName" Height="35" FontSize="14"
                     Padding="8,4" Margin="0,0,0,10"/>

            <TextBlock Text="Location" Foreground="#555" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtLocation" Height="35" FontSize="14"
                     Padding="8,4" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Add Branch" Width="120" Height="35"
                        Background="#27AE60" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnAdd_Click" Margin="0,0,10,0"/>
                <Button Content="Update Branch" Width="120" Height="35"
                        Background="#2980B9" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnUpdate_Click" Margin="0,0,10,0"/>
                <Button Content="Delete Branch" Width="120" Height="35"
                        Background="#E74C3C" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- List -->
        <DataGrid Grid.Row="1" x:Name="DgBranches"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionChanged="DgBranches_SelectionChanged"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding BranchId}" Width="50"/>
                <DataGridTextColumn Header="Branch Name" Binding="{Binding BranchName}" Width="*"/>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Close" Height="35"
                Background="#95A5A6" Foreground="White"
                BorderThickness="0" Cursor="Hand"
                Click="BtnClose_Click"/>
    </Grid>
</Window>