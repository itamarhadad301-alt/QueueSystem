<Window x:Class="AdminClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard"
        Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F0F4F8">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">

            <TextBlock x:Name="TxtWelcome"
                       FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#2C3E50"
                       Margin="0,0,0,30"/>

            <Button Content="🏢  Manage Branches"
                    Height="50" FontSize="15"
                    Background="#2980B9" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,12"
                    Click="BtnBranches_Click"/>

            <Button Content="⚙️  Manage Services"
                    Height="50" FontSize="15"
                    Background="#8E44AD" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,12"
                    Click="BtnServices_Click"/>

            <Button Content="👥  Manage Users"
                    Height="50" FontSize="15"
                    Background="#27AE60" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,12"
                    Click="BtnUsers_Click"/>

            <Button Content="🎫  Call Queue"
                    Height="50" FontSize="15"
                    Background="#E67E22" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,30"
                    Click="BtnQueue_Click"/>

            <Button Content="Logout"
                    Height="38" FontSize="14"
                    Background="#E74C3C" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnLogout_Click"/>

        </StackPanel>
    </Grid>
</Window>
