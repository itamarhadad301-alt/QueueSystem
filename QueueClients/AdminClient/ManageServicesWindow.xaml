<Window x:Class="AdminClient.ManageServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Services"
        Height="500" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F0F4F8" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Manage Services" FontSize="20" FontWeight="Bold"
                       Foreground="#2C3E50" Margin="0,0,0,12"/>

            <TextBlock Text="Service Name" Foreground="#555" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtServiceName" Height="35" FontSize="14"
                     Padding="8,4" Margin="0,0,0,10"/>

            <TextBlock Text="Branch" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbBranch" Height="35" FontSize="14"
                      Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Add Service" Width="120" Height="35"
                        Background="#27AE60" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnAdd_Click" Margin="0,0,10,0"/>
                <Button Content="Update Service" Width="120" Height="35"
                        Background="#2980B9" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnUpdate_Click" Margin="0,0,10,0"/>
                <Button Content="Delete Service" Width="120" Height="35"
                        Background="#E74C3C" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="DgServices"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionChanged="DgServices_SelectionChanged"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ServiceId}" Width="50"/>
                <DataGridTextColumn Header="Service Name" Binding="{Binding ServiceName}" Width="*"/>
                <DataGridTextColumn Header="Branch ID" Binding="{Binding BranchId}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Close" Height="35"
                Background="#95A5A6" Foreground="White"
                BorderThickness="0" Cursor="Hand"
                Click="BtnClose_Click"/>
    </Grid>
</Window>