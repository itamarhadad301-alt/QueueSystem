<Window x:Class="AdminClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Queue System – Admin Login"
        Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F0F4F8">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <TextBlock Text="Admin Panel"
                       FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#2C3E50"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Username" Foreground="#555" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername"
                     Height="35" FontSize="14"
                     Padding="8,4"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Password" Foreground="#555" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtPassword"
                         Height="35" FontSize="14"
                         Padding="8,4"
                         Margin="0,0,0,20"/>

            <Button Content="Login"
                    Height="38" FontSize="14"
                    Background="#2C3E50" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnLogin_Click"/>

        </StackPanel>
    </Grid>
</Window>
