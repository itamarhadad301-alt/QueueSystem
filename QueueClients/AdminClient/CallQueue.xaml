<Window x:Class="AdminClient.CallQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Call Queue"
        Height="550" Width="650"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F0F4F8" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Call Queue" FontSize="20" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="0,0,0,12"/>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Branch:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CmbBranch" Width="160" Height="35"
                      SelectionChanged="CmbBranch_SelectionChanged" Margin="0,0,16,0"/>
            <TextBlock Text="Service:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CmbService" Width="160" Height="35"
                      SelectionChanged="CmbService_SelectionChanged"/>
        </StackPanel>

        <!-- Queue List -->
        <DataGrid Grid.Row="2" x:Name="DgQueue"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ticket #" Binding="{Binding TicketNumber}" Width="80"/>
                <DataGridTextColumn Header="User" Binding="{Binding UserId}" Width="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Time" Binding="{Binding CreatedAt}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="✅ Call Next" Width="130" Height="38"
                    Background="#27AE60" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnCallNext_Click" Margin="0,0,10,0"/>
            <Button Content="⏭ Skip" Width="100" Height="38"
                    Background="#E67E22" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnSkip_Click" Margin="0,0,10,0"/>
            <Button Content="❌ Close Ticket" Width="130" Height="38"
                    Background="#E74C3C" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnClose_Click" Margin="0,0,10,0"/>
            <Button Content="🔄 Refresh" Width="100" Height="38"
                    Background="#2980B9" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnRefresh_Click"/>
        </StackPanel>
    </Grid>
</Window>