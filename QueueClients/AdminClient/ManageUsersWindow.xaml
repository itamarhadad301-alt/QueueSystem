<Window x:Class="AdminClient.ManageUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Users"
        Height="550" Width="650"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F0F4F8" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Manage Users" FontSize="20" FontWeight="Bold"
                       Foreground="#2C3E50" Margin="0,0,0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="First Name" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtFirstName" Height="35" FontSize="14" Padding="8,4" Margin="0,0,0,8"/>
                    <TextBlock Text="Username" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUsername" Height="35" FontSize="14" Padding="8,4" Margin="0,0,0,8"/>
                    <TextBlock Text="Phone" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPhone" Height="35" FontSize="14" Padding="8,4"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Last Name" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtLastName" Height="35" FontSize="14" Padding="8,4" Margin="0,0,0,8"/>
                    <TextBlock Text="Password" Foreground="#555" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtPassword" Height="35" FontSize="14" Padding="8,4" Margin="0,0,0,8"/>
                    <TextBlock Text="Role" Foreground="#555" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbRole" Height="35" FontSize="14">
                        <ComboBoxItem Content="User"/>
                        <ComboBoxItem Content="Admin"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Add User" Width="110" Height="35"
                        Background="#27AE60" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnAdd_Click" Margin="0,0,10,0"/>
                <Button Content="Update User" Width="110" Height="35"
                        Background="#2980B9" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnUpdate_Click" Margin="0,0,10,0"/>
                <Button Content="Delete User" Width="110" Height="35"
                        Background="#E74C3C" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="BtnDelete_Click"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="DgUsers"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionChanged="DgUsers_SelectionChanged"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="40"/>
                <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Close" Height="35"
                Background="#95A5A6" Foreground="White"
                BorderThickness="0" Cursor="Hand"
                Click="BtnClose_Click"/>
    </Grid>
</Window>