<Window x:Class="RegularClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Queue System"
        Height="400" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F0F4F8">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">

            <TextBlock x:Name="TxtWelcome"
                       FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#2C3E50"
                       Margin="0,0,0,30"/>

            <Button Content="🎫  Take a Ticket"
                    Height="50" FontSize="15"
                    Background="#2980B9" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,12"
                    Click="BtnTakeTicket_Click"/>

            <Button Content="📋  My Ticket"
                    Height="50" FontSize="15"
                    Background="#27AE60" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,30"
                    Click="BtnMyTicket_Click"/>

            <Button Content="Logout"
                    Height="38" FontSize="14"
                    Background="#E74C3C" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnLogout_Click"/>

        </StackPanel>
    </Grid>
</Window>