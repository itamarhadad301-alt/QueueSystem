<Window x:Class="RegularClient.RegisterWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Queue System – Register"
        Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F0F4F8">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <TextBlock Text="Create Account"
                       FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#2C3E50"
                       Margin="0,0,0,20"/>

            <TextBlock Text="First Name" Foreground="#555" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtFirstName" Height="35" FontSize="14" Padding="8,4" Margin="0,0,0,10"/>

            <TextBlock Text="Last Name" Foreground="#555" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtLastName" Height="35" FontSize="14" Padding="8,4" Margin="0,0,0,10"/>

            <TextBlock Text="Username" Foreground="#555" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername" Height="35" FontSize="14" Padding="8,4" Margin="0,0,0,10"/>

            <TextBlock Text="Password" Foreground="#555" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtPassword" Height="35" FontSize="14" Padding="8,4" Margin="0,0,0,10"/>

            <TextBlock Text="Phone" Foreground="#555" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtPhone" Height="35" FontSize="14" Padding="8,4" Margin="0,0,0,10"/>

            <TextBlock Text="Email" Foreground="#555" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtEmail" Height="35" FontSize="14" Padding="8,4" Margin="0,0,0,20"/>

            <Button Content="Register"
                    Height="38" FontSize="14"
                    Background="#27AE60" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnRegister_Click"
                    Margin="0,0,0,10"/>

            <Button Content="Back to Login"
                    Height="38" FontSize="14"
                    Background="#95A5A6" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnBack_Click"/>

        </StackPanel>
    </Grid>
</Window>