<Window x:Class="RegularClient.MyTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Ticket"
        Height="420" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F0F4F8">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">

            <TextBlock Text="My Ticket" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#2C3E50"
                       Margin="0,0,0,24"/>

            <Border Background="White" CornerRadius="8"
                    Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="TxtTicketNumber"
                               FontSize="48" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#2980B9"/>

                    <TextBlock x:Name="TxtStatus"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Foreground="#555"
                               Margin="0,8,0,0"/>

                    <TextBlock x:Name="TxtPosition"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Foreground="#27AE60"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="🔄  Refresh"
                    Height="40" FontSize="14"
                    Background="#2980B9" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,10"
                    Click="BtnRefresh_Click"/>

            <Button Content="❌  Cancel Ticket"
                    Height="40" FontSize="14"
                    Background="#E74C3C" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,10"
                    Click="BtnCancel_Click"/>

            <Button Content="Back"
                    Height="35" FontSize="14"
                    Background="#95A5A6" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnBack_Click"/>

        </StackPanel>
    </Grid>
</Window>