<Window x:Class="RegularClient.TakeTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Take a Ticket"
        Height="380" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F0F4F8">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">

            <TextBlock Text="Take a Ticket" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#2C3E50"
                       Margin="0,0,0,24"/>

            <TextBlock Text="Select Branch" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbBranch" Height="35" FontSize="14"
                      Margin="0,0,0,16"
                      SelectionChanged="CmbBranch_SelectionChanged"/>

            <TextBlock Text="Select Service" Foreground="#555" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbService" Height="35" FontSize="14"
                      Margin="0,0,0,24"/>

            <Button Content="🎫  Take Ticket"
                    Height="45" FontSize="15"
                    Background="#2980B9" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,0,10"
                    Click="BtnTake_Click"/>

            <Button Content="Back"
                    Height="35" FontSize="14"
                    Background="#95A5A6" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnBack_Click"/>

        </StackPanel>
    </Grid>
</Window>